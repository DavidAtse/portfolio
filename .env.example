# ── Configuration Base de Données (Production) ─────────────────────────────
DB_HOST=mysql-votrecompte.alwaysdata.net
DB_NAME=votrecompte_portfolio
DB_USER=votrecompte
DB_PASS=VOTRE_MOT_DE_PASSE_DB

# ── Configuration Base de Données (Local XAMPP) ────────────────────────────
LOCAL_DB_HOST=localhost
LOCAL_DB_NAME=portfolio_db
LOCAL_DB_USER=root
LOCAL_DB_PASS=

# ── Identifiants Administrateur ────────────────────────────────────────────
# Pour générer un hash : php -r "echo password_hash('VotreMotDePasse', PASSWORD_BCRYPT, ['cost' => 12]);"
ADMIN_USER=admin
ADMIN_PASS_HASH='$2y$12$REMPLACER_PAR_VOTRE_HASH_BCRYPT_SECURISE'
