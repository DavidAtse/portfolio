# ── Interdire toute exécution de script dans le dossier uploads ─────────────
Options -Indexes -ExecCGI

<FilesMatch "\.(php|php5|php7|php8|phtml|phar|pl|py|jsp|asp|aspx|htm|html|shtml|sh|cgi|svg|js|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
